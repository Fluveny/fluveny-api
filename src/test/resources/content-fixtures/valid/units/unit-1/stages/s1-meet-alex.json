          "responseKey": "hi-alex",
          "text": "Hi Alex! I'm {name}."
        },
        {
          "responseKey": "nice-too",
          "text": "**Nice to meet you** too!"
        },
        {
          "responseKey": "from-country",
          "text": "I [[am from|be-from]] {country}."
        },
        {
          "responseKey": "goodbye",
          "text": "Goodbye!"
        }
      ],
      "xp": 9
    },
    {
      "activityKey": "s1-gaps-bank",
      "type": "gaps",
