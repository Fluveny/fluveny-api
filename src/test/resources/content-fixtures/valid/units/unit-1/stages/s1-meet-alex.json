        },
        {
          "blockKey": "say-where",
          "title": {
            "he": "Where is he from?",
            "she": "Where is she from?",
            "they": "Where are they from?"
          },
          "items": [
            {
              "itemKey": "s1-greeting-cards-from",
              "text": {
                "he": "He [[is from|be-from]] **Canada**.",
                "she": "She [[is from|be-from]] **Canada**.",
                "they": "They [[are from|be-from]] **Canada**."
              }
            }
          ]
        }
      ]
    },
    {
      "activityKey": "s1-nice-to-meet-you",
      "type": "expression",
