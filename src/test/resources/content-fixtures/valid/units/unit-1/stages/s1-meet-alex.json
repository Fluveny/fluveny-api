        },
        {
          "lineKey": "ask-name",
          "speaker": "Alex",
          "text": "What's your name?",
          "ask": "name"
        },
        {
          "lineKey": "ask-country",
          "speaker": "Alex",
          "text": "Nice to meet you, {name}! Where are you from?",
          "ask": "country"
        },
        {
          "lineKey": "cool",
          "speaker": "Alex",
          "text": {
            "he": "Cool! He [[is from|be-from]] {country}.",
            "she": "Cool! She [[is from|be-from]] {country}.",
            "they": "Cool! They [[are from|be-from]] {country}."
          }
        }
      ]
    },
    {
      "activityKey": "s1-greeting-cards",
      "type": "cards",
      "title": "Greetings",
      "blocks": [
