              "optionKey": "nice-to-meet-you-too",
              "text": "**Nice to meet you** too!"
            },
            {
              "optionKey": "goodbye",
              "text": "Goodbye!"
            }
          ],
          "correctOptionKey": "nice-to-meet-you-too",
          "justification": "Respondemos com **too** para devolver o cumprimento."
        },
        {
          "itemKey": "s1-greetings-pronoun",
          "question": {
