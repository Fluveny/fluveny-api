  "openapi" : "3.1.0",
  "paths" : {
    "/api/v1/admin/content/units/{unitKey}/versions" : {
      "post" : {
        "operationId" : "publishUnitVersion",
        "parameters" : [ {
          "in" : "path",
          "name" : "unitKey",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "publish",
          "required" : false,
          "schema" : {
            "default" : true,
            "type" : "boolean"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UnitBundleContent"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponseUnitVersionPublication"
                }
              }
            },
            "description" : "A versão já existia"
          },
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponseUnitVersionPublication"
                }
              }
            },
            "description" : "Versão nova gravada"
          }
        },
        "tags" : [ "content-admin" ]
      }
    },
    "/api/v1/admin/content/units/{unitKey}/versions/{versionId}" : {
      "get" : {
        "operationId" : "getUnitVersion",
        "parameters" : [ {
          "in" : "path",
          "name" : "unitKey",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "path",
          "name" : "versionId",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApiResponseUnitVersionInfo"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "content-admin" ]
      }
    },
