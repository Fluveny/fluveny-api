{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluveny.github.io/content-schema/v1/activities/match.schema.json",
  "title": "Associar",
  "description": "Tipo Associar, Match the Speech Bubbles (FR-20, UX-DR76): o aluno liga cada fala de Alex (item) a uma resposta, em pares únicos. As respostas que nenhum item usa são os distratores. Cada correctResponseKey existe em responses, e dois itens não usam a mesma resposta (ContentValidator). Os campos x-fluveny-secret saem da visão do aluno (AD-6).",
  "type": "object",
  "additionalProperties": false,
  "required": ["activityKey", "type", "title", "items", "responses", "xp"],
  "properties": {
    "activityKey": { "$ref": "../key.schema.json" },
    "type": { "const": "match" },
    "title": { "$ref": "../text.schema.json" },
    "prompt": { "$ref": "../text.schema.json" },
    "items": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/item" }
    },
    "responses": {
      "description": "As respostas, na ordem de exibição; o servidor não embaralha. Inclui os distratores.",
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/response" }
    },
    "xp": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemKey", "line", "correctResponseKey"],
      "properties": {
        "itemKey": { "$ref": "../key.schema.json" },
        "line": { "$ref": "../text.schema.json" },
        "correctResponseKey": {
          "$ref": "../key.schema.json",
          "x-fluveny-secret": true
        },
        "justification": {
          "$ref": "../text.schema.json",
          "x-fluveny-secret": true
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responseKey", "text"],
      "properties": {
        "responseKey": { "$ref": "../key.schema.json" },
        "text": { "$ref": "../text.schema.json" }
      }
    },
    "answer": {
      "description": "Answer do Associar (AD-6): a resposta ligada a cada item, só pelas chaves. O texto da resposta, com o nome do aluno, nunca vai à API (AD-10).",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": { "const": "match" },
        "items": {
          "description": "Um par por item. Se a resposta cobre todos os itens, sem repetir item nem resposta, quem confere é o corretor.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/answerItem" }
        }
      }
    },
    "answerItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemKey", "responseKey"],
      "properties": {
        "itemKey": { "$ref": "../key.schema.json" },
        "responseKey": { "$ref": "../key.schema.json" }
      }
    }
  }
}
