{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluveny.github.io/content-schema/v1/activities/cards.schema.json",
  "title": "Cartões de expressões",
  "description": "Tipo Cartões de expressões (FR-14, UX-DR72), expositivo: blocos de cartões, cada um com um título, um ícone opcional e os cartões. Sem campo secreto, sem xp e sem Answer: a visão do aluno é a Atividade inteira, e a conclusão é VIEWED.",
  "type": "object",
  "additionalProperties": false,
  "required": ["activityKey", "type", "title", "blocks"],
  "properties": {
    "activityKey": { "$ref": "../key.schema.json" },
    "type": { "const": "cards" },
    "title": { "$ref": "../text.schema.json" },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockKey", "title", "items"],
      "properties": {
        "blockKey": { "$ref": "../key.schema.json" },
        "title": { "$ref": "../text.schema.json" },
        "emoji": {
          "description": "O ícone do bloco, um emoji (ex. 👋). Não é texto do conteúdo: não aceita placeholder nem marcação.",
          "type": "string",
          "minLength": 1,
          "maxLength": 16
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/item" }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemKey", "text"],
      "properties": {
        "itemKey": { "$ref": "../key.schema.json" },
        "text": { "$ref": "../text.schema.json" }
      }
    }
  }
}
