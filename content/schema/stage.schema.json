{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluveny.github.io/content-schema/v1/stage.schema.json",
  "title": "Estágio",
  "description": "content/units/<unitKey>/stages/<stageKey>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["stageKey", "title", "activities"],
  "properties": {
    "stageKey": { "$ref": "key.schema.json" },
    "title": { "$ref": "text.schema.json" },
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/activity" }
    }
  },
  "$defs": {
    "activity": {
      "description": "União dos Tipos de Atividade, discriminada por type (AD-6). Tipo novo: um valor no enum e um if/then para activities/<tipo>.schema.json.",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["choice", "dialogue", "cards", "expression", "speech", "match", "gaps"] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "choice" } }, "required": ["type"] },
          "then": { "$ref": "activities/choice.schema.json" }
        },
        {
          "if": { "properties": { "type": { "const": "dialogue" } }, "required": ["type"] },
          "then": { "$ref": "activities/dialogue.schema.json" }
        },
        {
          "if": { "properties": { "type": { "const": "cards" } }, "required": ["type"] },
          "then": { "$ref": "activities/cards.schema.json" }
        },
        {
          "if": { "properties": { "type": { "const": "expression" } }, "required": ["type"] },
          "then": { "$ref": "activities/expression.schema.json" }
        },
        {
          "if": { "properties": { "type": { "const": "speech" } }, "required": ["type"] },
          "then": { "$ref": "activities/speech.schema.json" }
        },
        {
          "if": { "properties": { "type": { "const": "match" } }, "required": ["type"] },
          "then": { "$ref": "activities/match.schema.json" }
        },
        {
          "if": { "properties": { "type": { "const": "gaps" } }, "required": ["type"] },
          "then": { "$ref": "activities/gaps.schema.json" }
        }
      ]
    }
  }
}
