      "activityKey": "s1-grammar-time",
      "type": "grammar",
      "title": "Verb to be & Possessive Adjectives",
      "used": [
        {
          "sentenceKey": "am",
          "form": "am",
          "sentence": "I'**m** from Brazil. → I **am** from Brazil."
        },
        {
          "sentenceKey": "is",
          "form": "is",
          "sentence": "My name **is** {name}."
        },
        {
          "sentenceKey": "are",
          "form": "are",
          "sentence": "Where **are** you from?"
        },
        {
          "sentenceKey": "my",
          "form": "my",
          "sentence": "**My** name is {name}."
        },
        {
          "sentenceKey": "your",
          "form": "your",
          "sentence": "What's **your** name?"
        }
      ],
      "rules": [
        {
          "ruleKey": "am",
          "form": "am",
          "use": "used only with **I**",
          "example": "I **am** a student."
        },
        {
          "ruleKey": "is",
          "form": "is",
          "use": "used with **He**, **She**, **It**",
          "example": "She **is** from Mexico."
        },
        {
          "ruleKey": "are",
          "form": "are",
          "use": "used with **You**, **We**, **They**",
          "example": "We **are** new here."
        },
        {
          "ruleKey": "my",
          "form": "my",
          "use": "used to talk about something that belongs to you",
          "example": "This is **my** bag."
        },
        {
          "ruleKey": "your",
          "form": "your",
          "use": "used to talk about something that belongs to the person you are speaking to",
          "example": "What's **your** name?"
        },
        {
          "ruleKey": "his",
          "form": "his",
          "use": "used for something that belongs to a male person",
          "example": "This is **his** book."
        },
        {
          "ruleKey": "her",
          "form": "her",
          "use": "used for something that belongs to a female person",
          "example": "This is **her** friend."
        },
        {
          "ruleKey": "its",
          "form": "its",
          "use": "used for something that belongs to an animal, object, or thing",
          "example": "The cat has **its** bed."
        },
        {
          "ruleKey": "our",
          "form": "our",
          "use": "used for something that belongs to us",
          "example": "This is **our** class."
        },
        {
          "ruleKey": "their",
          "form": "their",
          "use": "used for something that belongs to them",
          "example": "**Their** room is big."
        }
      ],
