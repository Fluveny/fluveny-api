# Copie para .env.local (fora do git) e preencha. O perfil local lê este
# arquivo sozinho; sem ele, a API sobe do mesmo jeito.

# Senha dos usuários que os carregadores do perfil local criam. Escolha uma
# senha qualquer, só sua; ela nunca vai para o código.
LOCAL_SEED_PASSWORD=

# Chave HMAC dos recibos do Visitante (base64, 32 bytes ou mais). Gere com
# `openssl rand -base64 32`. Opcional no perfil local: sem ela, a API gera uma
# chave a cada partida, e os recibos antigos deixam de valer.
FLUVENY_RECEIPT_KEY=
